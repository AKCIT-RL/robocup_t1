<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robocup_bringup</name>
  <version>1.0.0</version>
  <description>Launch files and configurations for RoboCup FlexBE + BehaviorTree system</description>
  <maintainer email="robocup@example.com">RoboCup Team</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>flexbe_onboard</depend>
  <depend>flexbe_webui</depend>
  <depend>flex_bt_server</depend>
  <depend>brain</depend>
  <depend>robocup_flexbe_behaviors</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
