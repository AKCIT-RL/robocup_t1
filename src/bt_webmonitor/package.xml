<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bt_webmonitor</name>
  <version>1.0.0</version>
  <description>Web-based real-time BehaviorTree monitor (Groot replacement)</description>
  <maintainer email="robocup@example.com">RoboCup Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>python3-fastapi</depend>
  <depend>python3-uvicorn</depend>
  <depend>python3-websockets</depend>
  <depend>python3-zmq</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
