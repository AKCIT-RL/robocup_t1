<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brain_bt_nodes</name>
  <version>1.0.0</version>
  <description>BehaviorTree.CPP plugin library containing custom nodes for RoboCup brain package</description>
  <maintainer email="robocup@team.com">RoboCup Team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  
  <!-- BehaviorTree.CPP -->
  <depend>behaviortree_cpp</depend>
  
  <!-- Brain library - provides Brain class and custom types -->
  <depend>brain</depend>
  
  <!-- Robot interfaces -->
  <depend>booster_interface</depend>
  <depend>vision_interface</depend>
  <depend>game_controller_interface</depend>
  <depend>booster_msgs</depend>
  
  <!-- External libraries -->
  <depend>eigen</depend>
  <depend>opencv</depend>
  <depend>rerun_sdk</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml_cpp_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
